# Frontend Environment Variables (for Vite/React)
# Room management backend URL (default: http://localhost:8080)
VITE_ROOM_BACKEND_URL=http://localhost:8080

# Auth service backend URL (default: http://localhost:8000)
VITE_AUTH_BACKEND_URL=http://localhost:8000

# Frontend website URL (default: http://localhost:3000)
VITE_WEBSITE_URL=http://localhost:3000

# SuperTokens core URL (default: http://localhost:3567)
VITE_SUPERTOKENS_URL=http://localhost:3567

# Legacy variables (maintained for backward compatibility)
VITE_APP_API_URL=http://localhost:8000
VITE_APP_WEBSITE_URL=http://localhost:3000
VITE_APP_API_PORT=8000
VITE_APP_WEBSITE_PORT=3000

# Backend Environment Variables (for Django/Python)
# Room management backend URL
ROOM_BACKEND_URL=http://localhost:8080

# Auth service backend URL  
AUTH_BACKEND_URL=http://localhost:8000

# Frontend website URL
WEBSITE_URL=http://localhost:3000

# SuperTokens core URL
SUPERTOKENS_URL=http://localhost:3567

# Redis configuration (optional, defaults to localhost)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0